<UserControl x:Class="Dopamine.Controls.TrimRangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="56" d:DesignWidth="600"
             MinHeight="40"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Trim handle: a grip confined to the track band, so the full-height playhead stays visible above and below it -->
        <ControlTemplate x:Key="TrimHandleTemplate" TargetType="{x:Type Thumb}">
            <Border x:Name="Tab" CornerRadius="2" Background="{DynamicResource Brush_Accent}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="1" Height="6" Margin="1,0" Background="{DynamicResource Brush_WindowHeaderBackground}" Opacity="0.6"/>
                    <Border Width="1" Height="6" Margin="1,0" Background="{DynamicResource Brush_WindowHeaderBackground}" Opacity="0.6"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tab" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="Tab" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Canvas x:Name="RootCanvas"
            Background="Transparent"
            Cursor="Hand"
            SizeChanged="RootCanvas_SizeChanged"
            MouseLeftButtonDown="RootCanvas_MouseLeftButtonDown"
            MouseMove="RootCanvas_MouseMove"
            MouseLeftButtonUp="RootCanvas_MouseLeftButtonUp"
            LostMouseCapture="RootCanvas_LostMouseCapture">
        <!-- Full track -->
        <Rectangle x:Name="TrackRectangle" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush_SliderBackground}" IsHitTestVisible="False"/>
        <!-- Kept range -->
        <Rectangle x:Name="SelectionRectangle" Height="10" Fill="{DynamicResource Brush_Accent}" Opacity="0.55" IsHitTestVisible="False"/>
        <!-- Playhead -->
        <Rectangle x:Name="PlayheadRectangle" Width="2" Fill="{DynamicResource Brush_PrimaryText}" IsHitTestVisible="False"/>
        <!-- Trim handles -->
        <Thumb x:Name="StartThumb" Template="{StaticResource TrimHandleTemplate}" Cursor="SizeWE"
               DragStarted="Thumb_DragStarted" DragDelta="StartThumb_DragDelta"
               ToolTip="{DynamicResource Language_YouTube_Trim_Start}"/>
        <Thumb x:Name="EndThumb" Template="{StaticResource TrimHandleTemplate}" Cursor="SizeWE"
               DragStarted="Thumb_DragStarted" DragDelta="EndThumb_DragDelta"
               ToolTip="{DynamicResource Language_YouTube_Trim_End}"/>
    </Canvas>
</UserControl>
