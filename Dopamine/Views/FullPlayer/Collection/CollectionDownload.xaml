<UserControl x:Class="Dopamine.Views.FullPlayer.Collection.CollectionDownload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding UnloadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <!-- Rows highlight on hover only; selection has no meaning on this page -->
        <Style x:Key="YouTubeResultItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="RowBorder" Background="Transparent" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush_ItemSeparator}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush_ItemHovered}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetaTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_SecondaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ThinProgressBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource Brush_SliderBackground}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource Brush_Accent}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="YouTubeResultTemplate">
            <Grid Height="58">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Thumbnail with play/stop preview button -->
                <Grid Grid.Column="0" Width="96" Height="54">
                    <Border Background="{DynamicResource Brush_CoverTileBackground}"/>
                    <Image Source="{Binding ThumbnailUrl, IsAsync=True}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button Style="{StaticResource TransparentButton}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                            CommandParameter="{Binding}">
                        <Button.ToolTip>
                            <TextBlock Text="{DynamicResource Language_YouTube_Preview}"/>
                        </Button.ToolTip>
                        <Border Width="32" Height="32" CornerRadius="16" Background="#B0000000">
                            <Grid>
                                <dc:SegoeIcon Text="&#xE768;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"
                                              Visibility="{Binding IsPreviewIdle, Converter={StaticResource BooleanToCollapsedConverter}}"/>
                                <dc:SegoeIcon Text="&#xE71A;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding IsPreviewPlaying, Converter={StaticResource BooleanToCollapsedConverter}}"/>
                                <Viewbox Width="22" Height="22" Visibility="{Binding IsPreviewLoading, Converter={StaticResource BooleanToCollapsedConverter}}">
                                    <dc:ProgressRing Foreground="White" IsActive="{Binding IsPreviewLoading}"/>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>

                <!-- Title + meta information -->
                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush_PrimaryText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Uploader}" ToolTip="{Binding Uploader}" MaxWidth="260" TextTrimming="CharacterEllipsis" Style="{StaticResource MetaTextStyle}"/>
                        <TextBlock Text="  •  " Style="{StaticResource MetaTextStyle}"/>
                        <dc:SegoeIcon Text="&#xE916;" FontSize="11" Foreground="{DynamicResource Brush_SecondaryText}" VerticalAlignment="Center" Margin="0,1,4,0"/>
                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource MetaTextStyle}"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasUploadDate, Converter={StaticResource BooleanToCollapsedConverter}}">
                            <TextBlock Text="  •  " Style="{StaticResource MetaTextStyle}"/>
                            <dc:SegoeIcon Text="&#xE787;" FontSize="11" Foreground="{DynamicResource Brush_SecondaryText}" VerticalAlignment="Center" Margin="0,1,4,0"/>
                            <TextBlock Text="{Binding UploadDateText}" Style="{StaticResource MetaTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Watch on YouTube -->
                <Button Grid.Column="2" Width="36" Height="36" Margin="0,0,8,0" Style="{StaticResource TransparentButton}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding DataContext.OpenVideoCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                        CommandParameter="{Binding}">
                    <Button.ToolTip>
                        <TextBlock Text="{DynamicResource Language_YouTube_Open_Video}"/>
                    </Button.ToolTip>
                    <dc:SegoeIcon Text="&#xE8A7;" FontSize="15" Foreground="{DynamicResource Brush_PrimaryText}"/>
                </Button>

                <!-- Download / progress / done -->
                <Grid Grid.Column="3" Width="130" VerticalAlignment="Center">
                    <Button Style="{StaticResource RegularButtonAccent}" Content="{DynamicResource Language_Download}"
                            Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding ShowDownloadButton, Converter={StaticResource BooleanToCollapsedConverter}}"/>
                    <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToCollapsedConverter}}">
                        <Grid Height="4">
                            <ProgressBar Style="{StaticResource ThinProgressBar}" Value="{Binding DownloadPercent, Mode=OneWay}"
                                         Visibility="{Binding IsDownloadIndeterminate, Converter={StaticResource InvertingBooleanToCollapsedConverter}}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Viewbox Width="12" Height="12" Margin="0,0,6,0"
                                     Visibility="{Binding IsDownloadIndeterminate, Converter={StaticResource BooleanToCollapsedConverter}}">
                                <dc:ProgressRing Foreground="{DynamicResource Brush_Accent}" IsActive="{Binding IsDownloadIndeterminate}"/>
                            </Viewbox>
                            <TextBlock Text="{Binding DownloadStatusText}" Style="{StaticResource MetaTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding IsAddedToCollection, Converter={StaticResource BooleanToCollapsedConverter}}">
                        <dc:SegoeIcon Text="&#xE73E;" FontSize="14" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Language_YouTube_Added}" FontSize="13" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="20,20,20,26">
        <!-- Search bar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15">
            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource RegularButtonAccent}"
                    Content="{DynamicResource Language_YouTube_Search}" Command="{Binding SearchCommand}"/>
            <Border Background="{DynamicResource Brush_TextBoxBackground}" Padding="6,4" VerticalAlignment="Center">
                <Grid>
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource MetroTextBox}" FontSize="14"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <!-- Watermark -->
                    <TextBlock Text="{DynamicResource Language_YouTube_Search_Watermark}" FontSize="14" Margin="3,0,0,0"
                               IsHitTestVisible="False" VerticalAlignment="Center" Foreground="{DynamicResource Brush_SecondaryText}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DockPanel>

        <Grid>
            <ListBox Panel.ZIndex="0"
                     ItemsSource="{Binding Results}"
                     ItemTemplate="{StaticResource YouTubeResultTemplate}"
                     ItemContainerStyle="{StaticResource YouTubeResultItemStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"/>

            <!-- Searching -->
            <StackPanel Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsSearching, Converter={StaticResource BooleanToCollapsedConverter}}">
                <Viewbox Width="40" Height="40">
                    <dc:ProgressRing Foreground="{DynamicResource Brush_Accent}" IsActive="{Binding IsSearching}"/>
                </Viewbox>
                <TextBlock Margin="0,15,0,0" Text="{DynamicResource Language_YouTube_Searching}" FontSize="15" FontWeight="Light"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Brush_PrimaryText}"/>
            </StackPanel>

            <!-- Hint / no results / errors -->
            <TextBlock Panel.ZIndex="1" MaxWidth="520" Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="15" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush_SecondaryText}"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToCollapsedConverter}}"/>
        </Grid>
    </DockPanel>
</UserControl>
